# Сервер
PORT=8886

#
# Telegram (@BotFather). Токен нужен не боту, а выводу общего секрета с
# auth-miniapp — переписки с ботом и webhook больше нет.
BOT_TOKEN=
BOT_USERNAME=

# Short name мини-аппа (@BotFather → /newapp) на том же боте. Обязателен:
# весь Telegram-вход идёт через него, другой дороги нет.
MINIAPP_SHORT_NAME=

# Секреты приложений через запятую — кто может вызывать /exchange и /delegate
APP_TOKENS=

# Куда редиректить, если auth-center открыли напрямую без ?redirect=
DIRECT_REDIRECT=

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-auth-center-domain/google/callback
